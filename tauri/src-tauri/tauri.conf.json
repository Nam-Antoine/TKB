{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "USTH Timetable",
  "version": "1.4.2",
  "identifier": "vn.edu.usth.timetable",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "USTH Timetable",
        "url": "index.html",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "center": true,
        "backgroundColor": "#f6f7fb"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFQTY0RDNGQTVBNzA2MkYKUldRdkJxZWxQMDJtdmpDVkRWVjZjdVpvaHhJMmpCZUxKUkVSUkhHRnB1SjZwMHR1VkdxeXB6d3AK",
      "endpoints": [
        "https://github.com/Nam-Antoine/TKB/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
